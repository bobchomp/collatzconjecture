# Copy this file to .env and fill in your own values. .env is gitignored.

# Required. The shared password the frontend must send to use your
# server. Pick something long and random -- this is the only thing
# standing between the internet and your homelab's CPU/RAM.
SCAN_API_PASSWORD=change-me-to-something-long-and-random

# Optional. Largest range end this server will accept. Can be set far
# higher than CACHE_CEILING below -- scanning past the cache ceiling
# just costs more compute time, not more memory (see server/README.md).
MAX_RANGE_END=1000000000

# Optional. Bounds the memoization cache's memory use independently of
# MAX_RANGE_END, at ~6 bytes/number. Lower this if your box has less
# RAM; the scanner still produces correct results above this value,
# just slower (see server/README.md for the tradeoff and real numbers).
CACHE_CEILING=1000000000

# Optional. How many worker threads split each scan across. Defaults
# to every CPU core the container can see; lower this to leave some
# cores free for other things running on the same box.
SCAN_THREADS=

# Optional. Comma-separated list of origins allowed to call this
# server (CORS). Defaults to the site's own domains.
ALLOWED_ORIGINS=https://collatz.rossmackenzie.co.uk,https://bobchomp.github.io

# Required only if you use the cloudflared service in docker-compose.yml
# to expose this over the internet. Get this from the Cloudflare Zero
# Trust dashboard when creating a tunnel -- see server/README.md.
TUNNEL_TOKEN=
